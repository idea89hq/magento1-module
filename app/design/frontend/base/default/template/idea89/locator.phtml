 *
 * @var Idea89_Assistant_Block_Locator $this
 *
 * M2→M1 substitutions:
 *   $block->...            → $this->...
 *   escapeHtmlAttr(...)    → escapeHtml(...)   (OpenMage provides both; attr context is safe)
 *   escapeJs(...)          → jsQuoteEscape(...) (escapes for single-quoted JS string context)
 */
$locations     = $this->getLocations();
$apiBase       = $this->escapeHtml($this->getApiBase());
$apiKey        = $this->escapeHtml($this->getApiKey());
$apiBaseJs     = $this->jsQuoteEscape($this->getApiBase());
$apiKeyJs      = $this->jsQuoteEscape($this->getApiKey());
$mapProvider   = $this->escapeHtml($this->getMapProvider());
$mapKey        = $this->getMapKey();
$mapKeyAttr    = $mapKey !== null ? $this->escapeHtml($mapKey) : null;
$defaultCountry     = $this->getDefaultCountryCode();
$defaultCountryAttr = $defaultCountry !== null ? $this->escapeHtml($defaultCountry) : null;
$nearestCount  = (int) $this->getNearestResultsCount();

$brandColor     = $this->getBrandColor();
$brandColorAttr = $brandColor !== null ? $this->escapeHtml($brandColor) : '#0B6B47';

$layoutMode = $this->getStorefinderLayout();

$cfg          = $this->getLocatorConfig();
$heroEyebrow  = (string) $cfg->getHeroEyebrow();
$heroH1       = (string) $cfg->getHeroH1();
$heroSubhead  = (string) $cfg->getHeroSubhead();
$helpHeading  = (string) $cfg->getHelpHeading();
$helpBody     = (string) $cfg->getHelpBody();
$helpCtaLabel = (string) $cfg->getHelpCtaLabel();
$helpCtaUrlRaw = (string) $cfg->getHelpCtaUrl();
$helpCtaUrlAttr = $this->escapeUrl($helpCtaUrlRaw) ?: $helpCtaUrlRaw;

$storeCount   = is_array($locations) ? count($locations) : 0;
$countries    = [];
$cities       = [];
foreach ($locations as $loc) {
    $addr = is_array($loc['address'] ?? null) ? $loc['address'] : [];
    $cc   = $addr['country_code'] ?? null;
    if ($cc && !isset($countries[$cc])) {
        $countries[$cc] = true;
    }
    $city = $addr['city'] ?? null;
    if ($city && !isset($cities[$city])) {
        $cities[$city] = true;
    }
}
$countryCount  = count($countries);
$cityCount     = count($cities);
$coverageLabel = $countryCount > 1
    ? (string) $countryCount . ' countries'
    : (in_array('GB', array_keys($countries), true) ? 'United Kingdom' : 'In your region');
$citiesLabel   = $cityCount > 0 ? ((string) $cityCount . ' cities') : '—';
?>

<?php foreach ($locations as $loc): ?>
<script type="application/ld+json"><?php /* @noEscape */ echo $this->renderStoreJsonLd($loc) ?></script>
<?php endforeach; ?>

